# ROS / Python 构建产物与运行日志
build/
install/
log/
ros2_ws/build/
ros2_ws/install/
ros2_ws/log/
runtime_logs/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/

# 运行数据
*.bag
*.db3
tests/logs/*
tests/simulation/*
!tests/logs/.gitkeep

# 本地参考与临时文件
.ref/
.tmp/
.tmpimg/          # 从 PDF 抽出的临时图片（调试图纸用）
.pylibs/          # pip --target 装的临时依赖（如 pillow/numpy/OCR）
*:Zone.Identifier

# 第三方克隆（不入库；需要时按 sim/launch/field_with_robot.launch.py 头部说明克隆）
ros2_ws/src/linorobot2/

# 大文件（CAD 导出/临时）
cad/exports/*.zip
!cad/exports/.gitkeep

.vscode