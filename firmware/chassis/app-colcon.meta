{
  "names": {
    "rmw_microxrcedds": {
      "cmake-args": [
        "-DRMW_UXRCE_TRANSPORT=custom",
        "-DRMW_UXRCE_MAX_TOPICS=5",
        "-DRMW_UXRCE_MAX_NODES=1",
        "-DRMW_UXRCE_MAX_PUBLISHERS=3",
        "-DRMW_UXRCE_MAX_SUBSCRIPTIONS=2",
        "-DRMW_UXRCE_MAX_HISTORY=4",
        "-DRMW_UXRCE_MAX_SERVICES=3"
      ]
    },
    "microxrcedds_client": {
      "cmake-args": [
        "-DUCLIENT_CUSTOM_TRANSPORT_MTU=2048"
      ]
    }
  }
}
