<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.10">
  <model name="ideal_robot">
    <!-- CAD geometry and fixed joint origins match dase7503_sim.urdf. The ideal base sets the model pose directly. -->
    <static>true</static>
    <link name="base_footprint" />
    <link name="base_link">
      <pose relative_to="base_footprint">0 0 0.016328981906188 0 0 0</pose>
      <collision name="base_link_collision_0">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>package://robot_description/meshes/robotcar/base_link.STL</uri>
          </mesh>
        </geometry>
      </collision>
      <visual name="base_link_visual_0">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>package://robot_description/meshes/robotcar/base_link.STL</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.894117647058823 0.894117647058823 0.894117647058823 1</ambient>
          <diffuse>0.894117647058823 0.894117647058823 0.894117647058823 1</diffuse>
        </material>
      </visual>
    </link>
    <link name="LF_link">
      <pose relative_to="base_link">0.0850000000000002 0.1012 0.0159999999999996 0 0 0</pose>
      <collision name="LF_link_collision_0">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>package://robot_description/meshes/robotcar/LF_link.STL</uri>
          </mesh>
        </geometry>
      </collision>
      <visual name="LF_link_visual_0">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>package://robot_description/meshes/robotcar/LF_link.STL</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.894117647058823 0.894117647058823 0.894117647058823 1</ambient>
          <diffuse>0.894117647058823 0.894117647058823 0.894117647058823 1</diffuse>
        </material>
      </visual>
    </link>
    <link name="LB_link">
      <pose relative_to="base_link">-0.0849999999999997 0.1012 0.0159999999999995 0 0 0</pose>
      <collision name="LB_link_collision_0">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>package://robot_description/meshes/robotcar/LB_link.STL</uri>
          </mesh>
        </geometry>
      </collision>
      <visual name="LB_link_visual_0">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>package://robot_description/meshes/robotcar/LB_link.STL</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.894117647058823 0.894117647058823 0.894117647058823 1</ambient>
          <diffuse>0.894117647058823 0.894117647058823 0.894117647058823 1</diffuse>
        </material>
      </visual>
    </link>
    <link name="RF_link">
      <pose relative_to="base_link">0.0849999999999997 -0.1012 0.0159999999999876 0 0 0</pose>
      <collision name="RF_link_collision_0">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>package://robot_description/meshes/robotcar/RF_link.STL</uri>
          </mesh>
        </geometry>
      </collision>
      <visual name="RF_link_visual_0">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>package://robot_description/meshes/robotcar/RF_link.STL</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.894117647058823 0.894117647058823 0.894117647058823 1</ambient>
          <diffuse>0.894117647058823 0.894117647058823 0.894117647058823 1</diffuse>
        </material>
      </visual>
    </link>
    <link name="RB_link">
      <pose relative_to="base_link">-0.0849999999999989 -0.000750000000000001 0.0159999999999999 1.5707963267949 -1.2988328850493 0</pose>
      <collision name="RB_link_collision_0">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>package://robot_description/meshes/robotcar/RB_link.STL</uri>
          </mesh>
        </geometry>
      </collision>
      <visual name="RB_link_visual_0">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>package://robot_description/meshes/robotcar/RB_link.STL</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.894117647058823 0.894117647058823 0.894117647058823 1</ambient>
          <diffuse>0.894117647058823 0.894117647058823 0.894117647058823 1</diffuse>
        </material>
      </visual>
    </link>
    <link name="Lidar">
      <pose relative_to="base_link">0.068835963325927 0 0.0848000000000003 0 0 0</pose>
      <collision name="Lidar_collision_0">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>package://robot_description/meshes/robotcar/Lidar.STL</uri>
          </mesh>
        </geometry>
      </collision>
      <visual name="Lidar_visual_0">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>package://robot_description/meshes/robotcar/Lidar.STL</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.894117647058823 0.894117647058823 0.894117647058823 1</ambient>
          <diffuse>0.894117647058823 0.894117647058823 0.894117647058823 1</diffuse>
        </material>
      </visual>
      <sensor name="scan_sensor" type="gpu_lidar">
        <pose>0 0 0 0 0 0</pose>
        <topic>/scan</topic>
        <update_rate>10</update_rate>
        <always_on>true</always_on>
        <visualize>true</visualize>
        <lidar>
          <scan>
            <horizontal>
              <samples>720</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159265</min_angle>
              <max_angle>3.14159265</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.05</min>
            <max>8.0</max>
            <resolution>0.01</resolution>
          </range>
        </lidar>
      </sensor>
    </link>
    <link name="Camera">
      <pose relative_to="base_link">0.001 0 0.127 0 0 0</pose>
      <collision name="Camera_collision_0">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>package://robot_description/meshes/robotcar/Camera.STL</uri>
          </mesh>
        </geometry>
      </collision>
      <visual name="Camera_visual_0">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>package://robot_description/meshes/robotcar/Camera.STL</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
        </material>
      </visual>
      <sensor name="front_camera" type="camera">
        <pose>0 0 0 0 -0.23 0</pose>
        <topic>/camera/image_raw</topic>
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <camera>
          <camera_info_topic>/camera/camera_info</camera_info_topic>
          <!-- Keep a 5 cm QR on the start post resolvable from the spawn point. -->
          <horizontal_fov>1.04719755</horizontal_fov>
          <image>
            <width>960</width>
            <height>720</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.03</near>
            <far>10.0</far>
          </clip>
          <optical_frame_id>camera_optical_frame</optical_frame_id>
        </camera>
      </sensor>
    </link>
    <joint name="LF_joint" type="fixed">
      <parent>base_link</parent>
      <child>LF_link</child>
    </joint>
    <joint name="LB_joint" type="fixed">
      <parent>base_link</parent>
      <child>LB_link</child>
    </joint>
    <joint name="RF_joint" type="fixed">
      <parent>base_link</parent>
      <child>RF_link</child>
    </joint>
    <joint name="RB_joint" type="fixed">
      <parent>base_link</parent>
      <child>RB_link</child>
    </joint>
    <joint name="lidar_joint" type="fixed">
      <parent>base_link</parent>
      <child>Lidar</child>
    </joint>
    <joint name="camera_joint" type="fixed">
      <parent>base_link</parent>
      <child>Camera</child>
    </joint>
    <joint name="base_joint" type="fixed">
      <parent>base_footprint</parent>
      <child>base_link</child>
    </joint>
  </model>
</sdf>
