<?xml version="1.0"?>
<!-- DASE7503 导航用 URDF（M4 维护）
     职责：提供导航/SLAM/AMCL 所需的 TF 链 odom(EKF发布) → base_footprint → base_link → laser/imu/cam。
     约定（见《模块接口说明》）：
       - /scan 的 frame_id = laser
       - EKF 的 base frame = base_footprint，odom frame = odom
     ⚠️ 传感器安装位置是【占位值】，装车后必须实测更新（外参按实测填写，别沿用示例）：
       - laser:  x=0.05 y=-0.05 z=0.15（来自 M1 初版 CAD 的平移值，高度按"雷达高置支架"取 0.15）
       - cam:    x=0.13 y=0.00 z=0.10（前置俯视 QR，待 M1-6 支架定形后实测）
       - imu:    车体中心（板载 ICM42670P， yaw 融合对位置不敏感）
     几何为简化包围盒，仅用于 costmap footprint 与可视化；精确外观见 dase7503_robot.urdf（SolidWorks 导出）。
-->
<robot name="dase7503_nav">

  <link name="base_footprint">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="0.005"/></geometry>
      <material name="black"><color rgba="0.1 0.1 0.1 1"/></material>
    </visual>
  </link>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.30 0.30 0.18"/></geometry>
      <material name="blue"><color rgba="0.2 0.4 0.9 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.30 0.30 0.18"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="2.5"/>
      <inertia ixx="0.037" ixy="0" ixz="0" iyy="0.037" iyz="0" izz="0.062"/>
    </inertial>
  </link>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.09" rpy="0 0 0"/>
  </joint>

  <!-- 雷达 MS200：TODO(实测) 安装外参 -->
  <link name="laser">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.035" length="0.05"/></geometry>
      <material name="dark"><color rgba="0.15 0.15 0.15 1"/></material>
    </visual>
  </link>
  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser"/>
    <origin xyz="0.05 -0.05 0.06" rpy="0 0 0"/>
  </joint>

  <!-- 板载 IMU（ICM42670P） -->
  <link name="imu_link"/>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- 前置相机（M3 扫码）：TODO(实测) -->
  <link name="cam_link"/>
  <joint name="cam_joint" type="fixed">
    <parent link="base_link"/>
    <child link="cam_link"/>
    <origin xyz="0.13 0 0.01" rpy="0 0.5 0"/>
  </joint>

</robot>
