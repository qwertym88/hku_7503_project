<?xml version="1.0"?>
<!-- Integration-only ideal base. Sensor heights are measured from the floor. -->
<robot name="dase7503_sim">
  <link name="base_footprint"/>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.30 0.30 0.08"/></geometry>
      <material name="blue"><color rgba="0.20 0.40 0.90 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.30 0.30 0.08"/></geometry>
    </collision>
  </link>
  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/><child link="base_link"/>
    <origin xyz="0 0 0.04" rpy="0 0 0"/>
  </joint>

  <link name="laser"/>
  <joint name="laser_joint" type="fixed">
    <parent link="base_footprint"/><child link="laser"/>
    <origin xyz="0.05 -0.05 0.09" rpy="0 0 0"/>
  </joint>

  <link name="cam_link"/>
  <joint name="camera_joint" type="fixed">
    <parent link="base_footprint"/><child link="cam_link"/>
    <origin xyz="0.13 0 0.15" rpy="0 0.5 0"/>
  </joint>

  <!-- ROS optical frame: +Z forward, +X right, +Y down. -->
  <link name="camera_optical_frame"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="cam_link"/><child link="camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.57079632679 0 -1.57079632679"/>
  </joint>
</robot>
